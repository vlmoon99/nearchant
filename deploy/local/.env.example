# Copy to deploy/local/.env (git-ignored) or export these. Only NEARCHANT_SECRET_KEY is required.
NEARCHANT_SECRET_KEY=          # >= 32 random chars; seals seller agent keys and bot tokens
NEAR_RELAYER_KEY=              # ed25519:… key of relayer.<root> (sponsored testnet accounts, billing settlement)
NEARAI_API_KEY=                # NEAR AI Cloud; leave empty + set REPLAY_DIR to run on recorded answers
NC_LOCAL_LLM_KEY=              # key of your own vLLM endpoint in config/providers.yaml
SEARXNG_URL=                   # web search for research scouts (optional)
REPLAY_DIR=                    # e.g. /app/fixtures/replay for the judge demo
PUBLIC_URL=http://localhost:8787
CF_TUNNEL_TOKEN=               # for the optional tunnel profile
TRUST_PROXY=                   # "cloudflare" when behind the tunnel (rate limits use CF-Connecting-IP), else empty
