{
  "name": "@nearchant/gateway",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Control-plane API: public + admin surfaces, seller cards, CORS, webhooks (architecture.md §9).",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "build:web": "esbuild ./web/checkout.ts --bundle --format=esm --target=es2022 --platform=browser --alias:util=./web/util-shim.js --minify --outfile=dist/web/checkout.js && esbuild ./web/app.ts --bundle --format=esm --target=es2022 --platform=browser --alias:util=./web/util-shim.js --minify --outfile=dist/web/app.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@nearchant/contracts": "workspace:*",
    "@nearchant/db": "workspace:*",
    "@nearchant/near": "workspace:*",
    "@nearchant/providers": "workspace:*",
    "@nearchant/swarm": "workspace:*",
    "drizzle-orm": "0.45.4",
    "graphile-worker": "0.18.0",
    "hono": "4.13.14",
    "near-api-js": "7.4.0",
    "sharp": "0.34.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  }
}
